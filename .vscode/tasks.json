{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "VITE.*"
        }
      }
    },
    {
      "label": "Backend Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/backend",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Server running.*"
        }
      }
    },
    {
      "label": "DB Migrate",
      "type": "shell",
      "command": "npm",
      "args": ["run", "db:migrate"],
      "cwd": "${workspaceFolder}/backend",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "cd frontend && npm install && cd ../backend && npm install"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build All",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "cd frontend && npm run build && cd ../backend && npm run build"],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
